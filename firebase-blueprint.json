{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "User profile document created upon signing in with Google.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID from Firebase Auth"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's Google Account Email"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "email", "createdAt", "updatedAt"]
    },
    "userProject": {
      "title": "User Saved Network Project",
      "description": "Network topology project saved to the user's cloud account.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique project identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "name": {
          "type": "string",
          "description": "Network project name",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Topology notes or description",
          "maxLength": 500
        },
        "projectJson": {
          "type": "string",
          "description": "Serialized NetworkProject JSON data",
          "maxLength": 500000
        },
        "deviceCount": {
          "type": "number",
          "description": "Total number of devices"
        },
        "linkCount": {
          "type": "number",
          "description": "Total number of cables/links"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified timestamp"
        }
      },
      "required": ["id", "userId", "name", "projectJson", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Private user profile collection restricted to the authenticated owner."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "userProject",
      "description": "Cloud-saved network topologies owned by the authenticated user."
    }
  }
}
